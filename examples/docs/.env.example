# copy to .env locally; never commit populated values
NODE_ENV=development
DATABASE_URL=postgresql://gate_server:replace-me@127.0.0.1:5432/gates
MIGRATION_DATABASE_URL=postgresql://gate_migrator:replace-me@127.0.0.1:5432/gates
BETTER_AUTH_URL=http://127.0.0.1:3000/api/auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GATES_TENANT_ID=my-application
IRONDOME_API_KEY=replace-with-your-server-side-key
